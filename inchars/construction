        elif uid in ceos and CEO not in nr and len(ceos) <= 1:
            st.error("There must be at least one CEO.")
        else:
            set_user_roles(uid, nr)
            if CEO not in nr:
                set_user_sites(uid, [site_ids[n] for n in nf] if any(r in FIELD_ROLES for r in nr) else [])
